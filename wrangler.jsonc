{
  "name": "the-mailroom",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // The admin UI. The Worker runs first so it can gate everything behind the owner session.
  "assets": { "directory": "./ui", "binding": "ASSETS", "run_worker_first": true }
  // Secrets (never committed): OWNER_PASSWORD, SESSION_SECRET; optional CALLBACK_SECRET (signs callbacks) and PUSH_URL (phone push). Local dev reads them from .dev.vars (see .dev.vars.example).
}
